<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 1.0.8: the starting window matches the app theme. LaunchTheme (the
         manifest default) is the dark theme, the app's default. On Android
         13+ MainActivity picks LaunchThemeLight / LaunchThemeSystem for the
         next launches (SplashScreen.setSplashScreenTheme) when the user chose
         Light / System; on every version it sets the window colour before
         Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/veilon_bg_dark</item>
        <item name="android:colorBackground">@color/veilon_bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="LaunchThemeLight" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/veilon_bg_light</item>
        <item name="android:colorBackground">@color/veilon_bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="LaunchThemeSystem" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/veilon_bg_system</item>
        <item name="android:colorBackground">@color/veilon_bg_system</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Window behind the Flutter view after start; MainActivity sets its
         colour from the theme choice. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/veilon_bg_dark</item>
        <item name="android:colorBackground">@color/veilon_bg_dark</item>
    </style>
</resources>
