{
  "name": "veilon-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit -p . && vite build",
    "build:mock": "tsc --noEmit -p . && vite build --mode mock --outDir dist-mock",
    "preview:mock": "npm run build:mock && node scripts/serve.mjs dist-mock",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.70.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "uplot": "^1.6.32",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.6",
    "vite": "^5.4.21"
  }
}
