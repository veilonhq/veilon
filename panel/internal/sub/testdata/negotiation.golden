mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: true
proxies:
    - name: VL WS
      type: vless
      server: 198.51.100.7
      port: 8080
      uuid: 0b8a4c51-8a43-4c3b-9d7e-6f2a1b3c4d5e
      udp: true
      network: ws
      ws-opts:
